<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.sanchr.sync.messages</string>
		<string>com.sanchr.sync.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sanchr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Sanchr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Sanchr needs camera access for video calls and photos.</string>
	<key>NSContactsUsageDescription</key>
	<string>Sanchr needs access to your contacts to find friends who use the app.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock Sanchr.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sanchr uses your location only when you tap to share it in a chat. Coordinates are end-to-end encrypted and never sent to Sanchr servers.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sanchr uses the microphone for voice messages and calls.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Sanchr saves photos and videos from chats to your library when you tap Save.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sanchr needs photo library access to share photos and videos.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
		<string>voip</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string></string>
</dict>
</plist>
